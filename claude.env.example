# init-host.sh 会从 ~/.claude/settings.json 的 env 段自动生成该文件。
# 也可以手动复制为 ~/.claude-docker/claude.env 后填写。

# 方式一：Anthropic 官方 API
ANTHROPIC_API_KEY=sk-ant-replace-me

# 方式二：兼容 Anthropic 协议的第三方网关（与方式一互斥）
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=replace-me
# ANTHROPIC_MODEL=your-model
# ANTHROPIC_DEFAULT_OPUS_MODEL=your-opus-model
# ANTHROPIC_DEFAULT_SONNET_MODEL=your-sonnet-model
# ANTHROPIC_DEFAULT_HAIKU_MODEL=your-haiku-model

CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
